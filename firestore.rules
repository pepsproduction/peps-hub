rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      // Firebase Auth users are created by the project owner; custom admin claims
      // can be added later without changing the client or the data model.
      return signedIn() && (request.auth.token.admin == true || request.auth.token.email != null);
    }

    function publishedStatus() {
      return resource.data.status in ['published', 'live', 'ended'];
    }

    match /events/{eventId} {
      allow read: if publishedStatus();
      allow create, update, delete: if admin();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /photoEvents/{photoEventId} {
      allow read: if resource.data.status == 'published';
      allow create, update, delete: if admin();
    }

    match /matchPairs/{pairId} {
      allow read: if get(/databases/$(database)/documents/photoEvents/$(resource.data.photoEventId)).data.status == 'published';
      allow create, update, delete: if admin();
    }

    match /photos/{photoId} {
      allow read: if resource.data.photoEventId is string
        && get(/databases/$(database)/documents/photoEvents/$(resource.data.photoEventId)).data.status == 'published';
      allow create, update, delete: if admin();
    }

    // View analytics must be written by a trusted server/Cloud Function.
    match /analytics/{document=**} {
      allow read, write: if admin();
    }

    match /admins/{uid} {
      allow read: if admin() && request.auth.uid == uid;
      allow write: if admin();
    }

    // The app keeps one current state document so public pages and the admin
    // workspace stay in sync across browsers. The legacy document remains
    // readable for older clients, but only the current document is writable.
    match /appState/{documentId} {
      allow read: if documentId in ['pepshub', 'pepshub-v2', 'pepshub-v3'];
      allow create, update, delete: if documentId == 'pepshub-v3' && admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
